  "services": {
    "set_grind": {
      "name": "Set grind setting",
      "description": "Tell the controller the grinder is now at this setting (stored steps).",
      "fields": {
        "setting": {"name": "Setting", "description": "Grinder setting in stored steps (1-2000)."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "rate_shot": {
      "name": "Rate a shot",
      "description": "Rate a shot and say how it tasted. Without a shot id, the newest shot.",
      "fields": {
        "rating": {"name": "Rating", "description": "0 to 5 stars (0 clears)."},
        "taste": {"name": "Taste", "description": "0 not said, 1 sour, 2 balanced, 3 bitter."},
        "shot_id": {"name": "Shot id", "description": "Optional; the newest shot when left out."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "set_shot_tds": {
      "name": "Set shot TDS",
      "description": "Record a refractometer reading for a shot (0 clears).",
      "fields": {
        "tds": {"name": "TDS", "description": "Percent, 0.5 to 25, or 0 to clear."},
        "shot_id": {"name": "Shot id", "description": "Optional; the newest shot when left out."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "bag_finished": {
      "name": "Bag finished",
      "description": "Mark the coffee's bag as used up (the coffee in use when no id is given).",
      "fields": {
        "coffee_id": {"name": "Coffee id", "description": "Optional; the coffee in use when left out."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "subscription_arrived": {
      "name": "Subscription arrived",
      "description": "A subscription delivery arrived; moves its next date on.",
      "fields": {
        "subscription_id": {"name": "Subscription id", "description": "The subscription's id."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "subscription_skip": {
      "name": "Skip a subscription delivery",
      "description": "Skip the next delivery of a subscription.",
      "fields": {
        "subscription_id": {"name": "Subscription id", "description": "The subscription's id."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    },
    "maintenance_done": {
      "name": "Maintenance done",
      "description": "Mark an upkeep job done today.",
      "fields": {
        "job": {"name": "Job", "description": "Backflush, descale or grinder clean."},
        "entry_id": {"name": "Controller", "description": "Which controller (optional when there is one)."}
      }
    }
  }
