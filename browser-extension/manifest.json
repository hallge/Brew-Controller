{
  "manifest_version": 3,
  "name": "Brew Controller helper",
  "version": "0.1.3",
  "description": "Brings your coffee subscriptions' next delivery and coffee from the shops you are signed in to, to your Brew Controller.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{ "matches": ["http://*/*"], "js": ["relay.js"], "run_at": "document_end" }],
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "icons": { "128": "icon.png" }
}
